{
  "name": "shortbox-react",
  "version": "1.31.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20 <26",
    "npm": ">=10 <12"
  },
  "dependencies": {
    "@apollo/client": "^3.11.10",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@loliman/shortbox-contract": "^2.14.0",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "7.3.8",
    "dateformat": "^3.0.3",
    "dompurify": "^3.3.1",
    "formik": "^2.4.6",
    "graphql": "^16.9.0",
    "notistack": "^3.0.1",
    "query-string": "^9.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/typed-document-node": "^6.1.5",
    "@graphql-codegen/typescript": "^5.0.7",
    "@graphql-codegen/typescript-operations": "^5.0.7",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "10.0.1",
    "globals": "^17.3.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.2",
    "vite": "^7.1.0",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "check:artifacts": "sh -c \"if git ls-files | grep -E '(^|/)(dist|build|logs|listen)/|\\\\.log$|(^|/)\\\\.output\\\\.txt$|(^|/)output\\\\.txt$'; then echo 'Remove tracked build/runtime artifacts before commit.'; exit 1; fi\"",
    "start": "vite",
    "dev": "vite",
    "prebuild": "npm run check:artifacts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "codegen": "graphql-codegen --config codegen.yml",
    "codegen:check": "npm run codegen && git diff --exit-code -- src/graphql/typed-documents.generated.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "qa": "npm run check:artifacts && npm run typecheck && npm run lint && npm run test:coverage && npm run build",
    "start:mock": "VITE_MOCK_MODE=true vite",
    "dev:mock": "VITE_MOCK_MODE=true vite"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "overrides": {
    "minimatch": "10.2.2"
  }
}
