{
  "name": "shortbox-react",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20 <26",
    "npm": ">=10 <12"
  },
  "dependencies": {
    "@apollo/client": "^3.11.10",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@loliman/shortbox-contract": "^0.5.0",
    "@mui/icons-material": "^6.4.6",
    "@mui/material": "^6.4.6",
    "dateformat": "^3.0.3",
    "dompurify": "^3.3.1",
    "formik": "^2.4.6",
    "graphql": "^16.9.0",
    "notistack": "^3.0.1",
    "query-string": "^6.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "contract:codegen": "node scripts/contract-codegen.cjs codegen",
    "contract:codegen:frontend": "node scripts/contract-codegen.cjs codegen:frontend",
    "check:artifacts": "sh -c \"if git ls-files | grep -E '(^|/)(dist|build|logs|listen)/|\\\\.log$|(^|/)\\\\.output\\\\.txt$|(^|/)output\\\\.txt$'; then echo 'Remove tracked build/runtime artifacts before commit.'; exit 1; fi\"",
    "start": "vite",
    "dev": "vite",
    "prebuild": "npm run check:artifacts && npm run contract:codegen && npm run contract:codegen:frontend",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "qa": "npm run check:artifacts && npm run typecheck && npm run lint && npm run test:coverage && npm run build",
    "start:mock": "VITE_MOCK_MODE=true vite",
    "dev:mock": "VITE_MOCK_MODE=true vite"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
